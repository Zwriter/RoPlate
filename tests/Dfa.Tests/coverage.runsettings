<?xml version="1.0" encoding="utf-8"?>
<!-- Line coverage of Dfa.Core only (constitution: >= 70%); Dfa.App is referenced by the tests but not measured. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[Dfa.Core]*</Include>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>

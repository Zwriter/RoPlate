<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Plain resource names ("even-a.dfa.json") so ExampleCatalog can find a file from its id. -->
    <EmbeddedResource Include="Examples\*.dfa.json" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
